# Copiez ce fichier en .env.local. Les deux valeurs sont publiques : la clé
# anonyme est faite pour vivre dans un navigateur, et elle n'ouvre rien par
# elle-même. Ce sont les politiques et les droits qui protègent, jamais le
# secret de cette clé.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé anon>
