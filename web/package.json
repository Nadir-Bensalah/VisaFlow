{
  "name": "visaflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_DEMO=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "smoke": "VITE_DEMO=1 vite build && (vite preview --port 4173 & sleep 4 && node smoke.mjs); pkill -f 'vite preview'",
    "moteur": "rm -rf /tmp/vfmoteur && tsc -p tsconfig.moteur.json && node /tmp/vfmoteur/moteur.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
